# MongoDB Atlas connection
MONGODB_HOST=cluster0.xxxxx.mongodb.net
MONGODB_USER=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_USER_DATABASE=your_user_db_name
MONGODB_SESSION_DATABASE=your_session_db_name

# Session secrets (use long random strings)
MONGODB_SESSION_SECRET=your_mongo_session_secret_here
NODE_SESSION_SECRET=your_node_session_secret_here

